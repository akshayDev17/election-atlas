// election-atlas: the Worker that serves the Election Atlas, its D1 database and
// its R2 bucket. Created by `portfolio-app bootstrap --public`; deployed by
// .github/workflows/deploy.yml.
{
  "name": "election-atlas",
  "main": "src/index.js",
  // the date the sibling frontends use
  "compatibility_date": "2026-10-10",

  // No "routes" here. This Worker answers only on its workers.dev preview URL
  // until the owner's approved routes are attached in a separate step
  // (akshayprabhakant.com/elections, /elections/*, /work/election-atlas and
  // /work/election-atlas/*); the deploy workflow refuses a config with routes.
  "workers_dev": true,

  "assets": {
    // built by backend/build_site.py: the Next.js export at the atlas's full
    // path (/elections/india/), with the data files exported from D1
    "directory": "../dist",
    "binding": "ASSETS",
    // Assets first (free, no Worker invocation); the Worker runs only for the
    // bill PDFs, which it streams from R2, and for the old address, which it
    // redirects (308) to /elections/india/.
    "run_worker_first": [
      "/elections/india/data/state-legislation/*",
      "/work/election-atlas",
      "/work/election-atlas/*"
    ]
  },

  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "election-atlas-docs" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "election-atlas",
      "database_id": "29a39717-fbde-4cf8-a7de-27392b1d7161",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
