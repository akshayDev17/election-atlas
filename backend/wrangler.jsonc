// election-atlas: the Worker that serves the Election Atlas, its D1 database and
// its R2 bucket. Created by `portfolio-app bootstrap --public`; deployed by
// .github/workflows/deploy.yml.
{
  "name": "election-atlas",
  "main": "src/index.js",
  // the date the sibling frontends use
  "compatibility_date": "2026-10-10",

  // No "routes" here. The owner's approved routes (akshayprabhakant.com/elections,
  // /elections/*, /work/election-atlas and /work/election-atlas/*) are live but
  // attached outside this config by portfolio-app; the deploy workflow refuses a
  // config with routes.
  "workers_dev": true,

  "assets": {
    // built by backend/build_site.py: the Next.js export at the atlas's full
    // path (/elections/india/), with the data files exported from D1
    "directory": "../dist",
    "binding": "ASSETS",
    // Assets first (free, no Worker invocation); the Worker runs only for the
    // bill PDFs, which it streams from R2, for the old address and the bare
    // /elections address, which it redirects (308) to /elections/india/, and
    // for the four pages, whose HTML it passes through site-shell for the
    // shared theme. The pages are listed one by one so every chunk and data
    // file stays free; a query (state/?s=IN-UP&y=2024) still matches, as
    // patterns match the path only.
    "run_worker_first": [
      "/elections",
      "/elections/",
      "/elections/india/data/state-legislation/*",
      "/work/election-atlas",
      "/work/election-atlas/*",
      "/elections/india/",
      "/elections/india/state/",
      "/elections/india/mp/",
      "/elections/india/mla/"
    ]
  },

  // The shared site parts (the theme, for now): the four pages' HTML goes
  // through site-shell's compose() (akshayDev17/site-themes, shell/).
  // site-shell must be deployed before this binding is, or this deploy fails.
  // src/index.js fails open: if site-shell is down, the page is served exactly
  // as built.
  "services": [{ "binding": "SHELL", "service": "site-shell" }],

  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "election-atlas-docs" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "election-atlas",
      "database_id": "29a39717-fbde-4cf8-a7de-27392b1d7161",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
